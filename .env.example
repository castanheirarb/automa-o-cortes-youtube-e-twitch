# ═══════════════════════════════════════════════════════════════════════════════
# CorteCerto034 — Configuração Refinada para Monetização
# ═══════════════════════════════════════════════════════════════════════════════

# ── Banco de Dados (Prisma / SQLite) ─────────────────────────────────────────
# Usado pela Agenda Esportiva (Watchdog). Não requer servidor externo.
DATABASE_URL="file:./prisma/corte.db"

# ── APIs de IA ────────────────────────────────────────────────────────────────
# Google Gemini — PRIMÁRIO para geração de copy, visão e análise de imagem
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_MODEL=gemini-2.5-pro

# Groq — GRATUITO: Whisper (transcrição) + GPT-OSS (fallback de copy)
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Copy (poster/metadata.js, comment-reply.js, smart-boundary.js, bilibili/metadata.js):
# fallback do Gemini — gpt-oss-120b é o maior modelo de PRODUÇÃO (não-preview) da
# Groq, melhor pra seguir instrução complexa/JSON estruturado. reasoning_effort:
# 'low' já é aplicado em todo lugar que usa isso (ver CLAUDE.md) — sem essa flag o
# modelo estoura max_tokens com raciocínio oculto antes do JSON de saída.
GROQ_COPY_MODEL=openai/gpt-oss-120b
# Transcrição (poster/metadata.js, captions.js, smart-boundary.js): turbo troca
# ~2pp de WER por ~2,7x mais barato e ~15% mais rápido — ok pra PT→PT (não
# traduzimos). Troque pra whisper-large-v3 se a precisão da transcrição virar
# gargalo real (afeta legenda e corte inteligente de boundary).
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ── OpenRouter — GRATUITO: 3º nível de fallback de VISÃO (thumbnail) ──────────
# src/processor/face-detect.js escolhe o melhor frame pra thumbnail assim:
# Gemini Vision (primário) → Groq Vision (2º nível — hoje sem modelo de visão
# disponível nesta conta, ver comentário no código) → OpenRouter (aqui) →
# fallback burro (frame fixo). Cadastro em https://openrouter.ai (cartão
# internacional normal pra verificação, sem cobrança no tier grátis) → gerar
# key em https://openrouter.ai/keys. Sem essa key, esse nível é pulado sem
# erro (cai pro próximo).
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Confirmado no catálogo público (openrouter.ai/api/v1/models) em 18/09/2026
# como gratuito e com input de imagem — modelos free da OpenRouter mudam com
# frequência, revalide antes de trocar. Alternativa free também confirmada:
# inclusionai/ling-3.0-flash-vl:free.
OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free

# ── YouTube Data API v3 — OAuth por canal (Comment Bot) ───────────────────────
# 1. Google Cloud Console → criar/selecionar projeto → habilitar "YouTube Data
#    API v3" → Credenciais → Criar credenciais → ID do cliente OAuth →
#    tipo de aplicativo "App para computador".
# 2. Client ID/Secret abaixo podem ser COMPARTILHADOS pelos 3 canais (mesmo
#    projeto GCP) — mas a cota de 10.000 unidades/dia da API também é
#    compartilhada entre os 3 canais nesse caso (ver detalhes no README do
#    Comment Bot / plano de implementação).
YOUTUBE_CLIENT_ID=XXXXXXXX.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-XXXXXXXXXXXXXXXXXXXXXXXX
# 3. Gere um refresh token POR CANAL (conta Google distinta cada um):
#      node poster/youtube-oauth-setup.js --channel main
#      node poster/youtube-oauth-setup.js --channel fe
#      node poster/youtube-oauth-setup.js --channel infantil
#      node poster/youtube-oauth-setup.js --channel gta6
#    O token cobre TANTO o Comment Bot quanto o Revenue-Aware Rotation (ver
#    seção mais abaixo) — os escopos de Analytics já vêm inclusos no setup.
#    Se o token foi gerado ANTES dessa segunda feature existir, refaça o
#    setup daquele canal pra adicionar os escopos novos (reautorização).
#    ARMADILHA JÁ VIVIDA: se o navegador estiver com sessão logada de outro
#    canal, a tela de consentimento pode autorizar o canal ERRADO sem avisar
#    — o script confirma o nome do canal autorizado no final, sempre confira
#    antes de colar o token. Se der "Access blocked: app not verified", falta
#    adicionar aquele e-mail em "Test users" na tela de consentimento OAuth do
#    Google Cloud Console (o app roda em modo Testing).
YOUTUBE_REFRESH_TOKEN_MAIN=1//XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
YOUTUBE_REFRESH_TOKEN_FE=1//XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
YOUTUBE_REFRESH_TOKEN_INFANTIL=1//XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
YOUTUBE_REFRESH_TOKEN_GTA6=1//XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Comment Bot (resposta automática a comentários do YouTube) ────────────────
# Responde comentários novos em TODOS os canais (principal, Canal da Fé, Canal
# Infantil) automaticamente via IA, sem fila de aprovação. Desative com
# --no-comment-bot (start.js) ou rode manualmente: npm run comment-bot
#
# Dentro do `npm run poster` (start.js), o bot roda 1 PASSADA POR DIA (não
# fica em polling contínuo) — mesmo padrão do Scanner/Trend Hunter/Stock
# Watcher: executa, encerra, e o launcher reinicia depois de COMMENT_BOT_HOURS
# horas. Padrão 24h = 1x/dia.
COMMENT_BOT_HOURS=24
# Intervalo de polling em segundos — só usado em execução manual contínua
# (`npm run comment-bot`, sem --once). Não afeta o serviço automático do
# start.js, que sempre roda com --once (ver COMMENT_BOT_HOURS acima).
COMMENT_BOT_INTERVAL=900
# IMPORTANTE: comece com true. Loga o comentário recebido + a resposta gerada
# pela IA SEM publicar nada (comments.insert nunca é chamado). Só troque para
# false depois de validar manualmente ao menos 1 ciclo em modo dry-run
# (npm run comment-bot:once).
COMMENT_BOT_DRY_RUN=true
# Espaçamento humano: atraso aleatório (segundos) antes de CADA resposta real
# (não se aplica em dry-run) — evita responder tudo em rajada de poucos
# segundos, que é o padrão mais óbvio de bot. Padrão: 30s a 4min por resposta.
COMMENT_REPLY_DELAY_MIN_SEC=30
COMMENT_REPLY_DELAY_MAX_SEC=240
# Máximo de respostas por canal POR CICLO — evita rajada em vídeo viral.
COMMENT_REPLY_MAX_PER_CYCLE=10
# Máximo de respostas por canal POR DIA (janela rolante 24h) — protege a cota
# da API (comments.insert custa 50 unidades; commentThreads.list custa 1).
# 50/canal/dia × 3 canais × 50 unidades = 7.500 unidades/dia, dentro do limite
# padrão de 10.000/dia do projeto GCP (deixa ~2.200 de folga).
COMMENT_REPLY_MAX_PER_DAY=50
# Porta local usada só durante `node poster/youtube-oauth-setup.js` para
# capturar o redirect do OAuth — mude apenas se a porta 51739 estiver ocupada.
YOUTUBE_OAUTH_REDIRECT_PORT=51739

# ── Plataformas de Postagem (interruptores globais, poster/index.js) ──────────
# Liga/desliga cada plataforma no ciclo de upload (round-robin principal +
# canais dedicados). Default: todas ligadas (só desliga com 'false' explícito).
# Sobrepostos por CLI (--youtube-only / --tiktok-only / --instagram-only, cada
# um exclui as outras duas nessa execução) e, por persona, por
# skipYoutube/skipTikTok/skipInstagram em src/capturer/personas.js — uma
# persona com youtubeProfileDir/tiktokProfileDir/instagramProfileDir dedicado
# SEMPRE tenta aquela plataforma, ignorando o interruptor global.
UPLOAD_TO_YOUTUBE=true
UPLOAD_TO_TIKTOK=true
UPLOAD_TO_INSTAGRAM=true
# Máx. de hashtags na caption do Reels (Instagram pune "chuva" de hashtags
# mais que o TikTok — poster/metadata.js formatInstagramCaption).
INSTAGRAM_MAX_HASHTAGS=8

# Intervalo mínimo (minutos) forçado entre posts REAIS numa mesma plataforma,
# independente do cron — poster/upload-pacing.js. Default 0 (sem limite) pra
# TikTok/YouTube; Instagram vem com piso conservador (4h) desde o incidente de
# 2026-09-15 (8 uploads em ~40min numa conta nova travaram todos em
# "Compartilhando" — suspeita de rate-limit por rajada). Só reduzir depois de
# confirmar que a conta voltou ao normal com posts espaçados.
INSTAGRAM_MIN_INTERVAL_MIN=240
TIKTOK_MIN_INTERVAL_MIN=0
YOUTUBE_MIN_INTERVAL_MIN=0

# ── Twitch API ────────────────────────────────────────────────────────────────
TWITCH_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWITCH_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── TikTok ────────────────────────────────────────────────────────────────────
TIKTOK_SESSION_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Monitor de Lives TikTok (src/capturer/live-monitor-tiktok.js) ──────────────
# Orientado a evento via WebSocket (tiktok-live-connector) — não faz polling.
# Detecção de status/chat/gift público funciona SEM nenhuma credencial abaixo;
# elas só aumentam confiabilidade/limite de uso e destravam lives restritas.
#
# Chave grátis em https://www.eulerstream.com — sem ela, o monitor usa o limite
# compartilhado (anônimo) do serviço de assinatura de URL, que pode falhar sob
# carga com várias personas monitoradas ao mesmo tempo.
EULERSTREAM_API_KEY=
# TIKTOK_SESSION_ID (acima) + TIKTOK_TT_TARGET_IDC: cookies `sessionid` e
# `tt-target-idc` de uma conta TikTok DEDICADA (perfil descartável, nunca a
# conta de upload dos canais — ver poster/login.js --platform tiktok --profile
# ./profiles/chrome-tiktok-monitor). Só necessário pra ver lives
# subscriber-only/com restrição de idade; deixe em branco pro caso comum.
TIKTOK_TT_TARGET_IDC=
# Minutos de gravação por live detectada (padrão: mesmo valor de LIVE_CAPTURE_MINUTES).
TIKTOK_LIVE_CAPTURE_MINUTES=30
# Caminho opcional pra um cookies.txt (formato Netscape) exportado do perfil
# dedicado acima, repassado ao yt-dlp na gravação — só necessário se a live
# gravada exigir sessão logada (mesma lógica do par de cookies acima).
TIKTOK_COOKIES_PATH=

# ── Backfill TikTok (src/trend-hunter/tiktok-persona-scout.js) ────────────────
# Personas TikTok não têm VOD arquivado — enquanto a live delas não acontece
# de novo, busca no YouTube lives BRUTAS/completas já re-hospedadas por outros
# canais (ex.: "Royal Clipes") e corta com o pipeline normal. NUNCA baixa um
# corte que outro canal já editou — os dois filtros abaixo existem pra isso:
# duração mínima descarta clipes curtos prontos de terceiros (a imensa maioria
# fica entre 20s-3min), sobrando só live bruta/recap longo.
TIKTOK_BACKFILL_MIN_DURATION=600
TIKTOK_BACKFILL_MIN_VIEWS=1000
# De quanto em quanto tempo o serviço roda (start.js) — barato de sobra
# (não fica reprocessando quando a persona já tem clipes suficientes).
TIKTOK_BACKFILL_HOURS=6

# ── Bilibili (projeto À PARTE — ver bilibili/, isolado das personas acima) ─────
# Canal novo, sem relação com as personas/rodízio do canal principal: clipa
# conteúdo viral CHINÊS (Douyin/outras fontes curadas em bilibili/sources.js) e
# publica com metadados em mandarim. Nunca entra no round-robin do poster/.
#
# Upload via `biliup` (https://github.com/biliup/biliup) em vez de Playwright:
# a Bilibili não tem API pública de upload para uso individual, mas a comunidade
# reverse-engenheirou a API interna do próprio site e empacotou nesse binário
# (autenticação por cookies — SESSDATA/bili_jct/DedeUserID). Baixe o release em
# https://github.com/biliup/biliup/releases e aponte o caminho aqui:
BILIUP_PATH=C:/Users/Gustavo/AppData/Local/bbup-app/binaries/biliup.exe
# Onde o cookies.json fica salvo após `npm run bilibili:login` (QR code, 1x
# manual — o login em si não dá pra automatizar, precisa escanear pelo app).
BILIBILI_COOKIES_PATH=./bilibili/profiles/bilibili-cookies.json
# Partição (tid) padrão pro conteúdo de games/cortes de stream — 171 = eSports
# highlights. Tabela completa: https://biliup.github.io/biliup/docs/reference/tid_ref
BILIBILI_DEFAULT_TID=171
# Teto de espera pelo upload (minutos) — escala com o tamanho do arquivo,
# mesmo padrão do YT_UPLOAD_WAIT_MAX_MIN/TT_UPLOAD_WAIT_MAX_MIN.
BILIBILI_UPLOAD_WAIT_MAX_MIN=60
# Fonte usada na legenda queimada — precisa ter glifos de chinês simplificado.
# "Impact" (usado pelas outras personas) não tem CJK; troque se a fonte abaixo
# não estiver instalada na máquina (Windows sem pacote de idioma do Leste
# Asiático pode não ter Microsoft YaHei por padrão — SimHei/SimSun também servem).
BILIBILI_CAPTION_FONT=Microsoft YaHei
# Partições (rid) do ranking oficial da Bilibili consultadas pelo trend-radar
# pra saber o que está bombando agora (API pública, sem autenticação):
# https://api.bilibili.com/x/web-interface/ranking/v2?rid={rid}&type=all
# 0 = ranking geral (todas as partições). Pra uma partição específica (jogos,
# anime...), abra bilibili.com/v/popular/rank/all no navegador, troque de aba
# e copie o rid da URL. Separados por vírgula.
BILIBILI_RADAR_RIDS=0
# Fontes de vídeo a clipar (URLs yt-dlp-compatíveis, ex.: Douyin), separadas por
# vírgula. Lista curada manualmente em bilibili/sources.js — sem fonte
# configurada aqui NEM lá, `npm run bilibili:run` não tem o que baixar.
BILIBILI_SOURCES=
# Canais do YouTube escaneados automaticamente por bilibili/scout.js (pega o
# vídeo mais visto ainda não usado) — lista curada em bilibili/sources.js
# (CURATED_CHANNELS). Separados por vírgula, complementa a lista no código.
BILIBILI_CHANNELS=
# Teste EXPLÍCITO (03/09/2026, não é migração): de vez em quando tenta um
# clipe de reação BR bem visual/não-verbal em vez de conteúdo chinês — aposta
# de que "estranheza" de idioma pode ser gancho pro público da Bilibili. Fração
# dos ciclos (0.15 = 15%) que sorteia essa fonte em vez do pool chinês normal
# — ver EXPERIMENTAL_BR_CHANNELS em bilibili/sources.js. 0 desativa o teste.
BILIBILI_BR_EXPERIMENT_RATE=0.15
# Canais BR extras (além de CURATED_CHANNELS/EXPERIMENTAL_BR_CHANNELS no
# código), separados por vírgula.
BILIBILI_BR_CHANNELS=
# Repost automático pro Bilibili mainland dos cortes que cortecerto034
# (rodízio principal) e Fé Move Montanha (religioso) já publicam no
# YouTube/TikTok — pedido do usuário 17/09/2026, ver bilibili/repost-queue.js
# e o hook em poster/index.js. Tem prioridade sobre as fontes externas acima
# em bilibili/schedule.js; só cai pro pool chinês/Roblox/BR quando a fila
# estiver vazia. GTA VI não participa (ver comentário em repost-queue.js).
# false desativa e volta ao comportamento antigo (só fontes externas).
BILIBILI_REPOST_ENABLED=true

# ── Bilibili: agendamento automático (bilibili/schedule.js) ────────────────────
# npm run bilibili:schedule — processo de longa duração, dispara um ciclo
# (bilibili/run.js) por horário listado abaixo. Picos de tráfego da Bilibili
# (pesquisa de 03/09/2026): ~6-9h, ~11-13h e ~20-23h em Pequim; prática
# recomendada é postar 30-60min ANTES de cada pico. Config atual (4x/dia,
# decisão explícita de 03/09/2026, não a recomendação original de 1x/dia —
# ver histórico) cobre as 3 janelas convertidas pro fuso do Brasil (diferença
# de 11h): 8h e 10h BRT (picos de 19h/21h em Pequim, o mais forte) + 19h e 23h
# BRT (picos de 6h/10h em Pequim, commute/almoço). Ajuste conforme o resultado
# real acumular em npm run bilibili:stats — a conta segue em cold start
# (0 seguidores), postar mais não necessariamente ajuda sem engajamento.
BILIBILI_CRON=0 8,10,19,23 * * *
BILIBILI_TIMEZONE=America/Sao_Paulo
# Relatório diário de audiência (views/likes/inscritos) — roda no MESMO
# processo do agendador de posts (npm run bilibili:schedule), direto no
# terminal, pra não depender de sessão de chat pra reportar status.
BILIBILI_REPORT_CRON=3 23 * * *
# Checagem mais leve (só os 3 vídeos mais recentes, 4 chamadas à API por
# disparo) — pode rodar mais vezes ao dia que o relatório completo sem
# problema. 2h em 2h fica bem abaixo de qualquer limiar razoável da API
# pública da Bilibili (sem limite documentado, mas x/web-interface/view já
# demonstrou ter proteção anti-bot — ver stats.js) e é mais que suficiente
# pra uma conta em cold start, onde views crescem devagar.
BILIBILI_RECENT_REPORT_CRON=0 */2 * * *

# ── Bilibili: corte por pico de chat (bilibili/chat-peaks.js) ─────────────────
# Quando a fonte é VOD de uma live do YouTube, corta em torno do momento de
# maior densidade de mensagens no chat original (replay arquivado pelo
# YouTube) — proxy de reação forte, equivalente ao heatmap das personas do
# canal principal. Sem replay de chat (vídeo editado/pré-gravado), processa o
# vídeo inteiro dentro do teto abaixo.
# Segundos antes/depois do pico incluídos no corte (padrão: 15s antes + 45s
# depois = 60s de clipe).
BILIBILI_PEAK_BEFORE_SEC=15
BILIBILI_PEAK_AFTER_SEC=45
# Teto de duração (segundos) pro fallback SEM pico detectado — acima disso,
# a fonte é pulada em vez de processar um "clipe" de dezenas de minutos.
BILIBILI_FALLBACK_MAX_DURATION_SEC=400

# ── Bilibili: detecção visual de legenda queimada (bilibili/caption-detect.js) ─
# Complementa a heurística de título (BILIBILI_CAPTION_FONT acima cobre só o
# caso "cover/karaokê") — compara densidade de borda (proxy de "tem texto
# aqui", sem OCR) entre a faixa inferior e superior do frame. Calibrado com 2
# amostras reais em 02/09/2026 — ajuste se der muito falso positivo/negativo.
BILIBILI_CAPTION_DETECT_BOTTOM_MEAN=15
BILIBILI_CAPTION_DETECT_RATIO=4

# ── Bilibili: painel de audiência (bilibili/stats.js) ─────────────────────────
# UID numérico da conta (aparece na URL do espaço pessoal:
# space.bilibili.com/<UID>) — usado só pra buscar o nº de inscritos via API
# pública (sem autenticação). npm run bilibili:stats
BILIBILI_ACCOUNT_UID=

# ── OBS Studio (espelhamento de tela na live) ─────────────────────────────────
# Habilite no OBS: Ferramentas → WebSocket Server Settings (OBS 28+ já vem com
# o servidor embutido). Copie a senha exibida lá para OBS_WS_PASSWORD.
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=
# Cena usada/criada pelo comando `npm run obs:mirror` (recebe Display Capture)
OBS_SCENE=Desktop

# ── Binários ──────────────────────────────────────────────────────────────────
FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe
YTDLP_PATH=C:/yt-dlp/yt-dlp.exe

# ── Processamento ─────────────────────────────────────────────────────────────
# Buffer antes e depois do pico (segundos). O clipe total é limitado por CLIP_DURATION_MAX.
CLIP_BUFFER_SECONDS=30
# Duração máxima do clipe em segundos. Intervalo ideal para Shorts/TikTok: 15–35s.
CLIP_DURATION_MAX=35
# Duração mínima: picos na borda do vídeo (ex.: pico aos 3s → clipe de 5s) são
# descartados na seleção do heatmap e barrados no processamento.
CLIP_DURATION_MIN=11
OUTPUT_DIR=./output
ADD_CAPTIONS=true
# Loop perfeito: fade-in 0.3s no início + fade-out 0.3s no fim do áudio (incentiva replay)
LOOP_FADE=true

# ── Layout do vídeo ───────────────────────────────────────────────────────────
# BLUR_BACKGROUND: técnica profissional — preserva o frame 16:9 COMPLETO.
#   O fundo é a própria imagem desfocada (boxblur) cobrindo 1080×1920.
#   A camada principal fica centralizada por cima, sem crop agressivo.
#   Recomendado para: gaming (HUD visível), reacts, entrevistas, podcasts.
#   Tem precedência sobre SPLIT_SCREEN quando ativado.
BLUR_BACKGROUND=false

# ── Layout por persona (sobrepõe as variáveis globais abaixo) ────────────────
# O campo `layout` em src/capturer/personas.js define o formato de cada fonte:
#   'hybrid' → painel 16:9 NATIVO (1080×608, zero upscale) ancorado no topo +
#              área inferior desfocada para as legendas. Ideal para GAMEPLAY:
#              preserva o HUD inteiro e evita o upscale de 1,78× do crop 9:16.
#   'blur'   → frame 16:9 completo centralizado sobre fundo desfocado
#   'split'  → facecam em cima + gameplay embaixo
#   'asd'    → crop 9:16 dinâmico seguindo quem fala (padrão para pessoas)
# Posição vertical do painel no modo híbrido (px a partir do topo)
HYBRID_PANEL_Y=380

# SPLIT_SCREEN (usado apenas quando BLUR_BACKGROUND=false):
# true  → Split-Screen: face cam (top) + gameplay (bottom) — 1080×1920
# false → Single-panel: crop 9:16 simples (ou ASD dinâmico quando disponível)
SPLIT_SCREEN=false

# ── Active Speaker Detection (ASD) ────────────────────────────────────────────
# Ativa o crop 9:16 dinâmico com MediaPipe (detecta quem está falando).
# Defina como false para usar apenas o Gemini (crop estático).
USE_ASD=true
# Caminho do Python com mediapipe instalado. Exemplos:
#   Windows (venv): C:/Users/Gustavo/AppData/Local/Programs/Python/Python312/python.exe
#   Windows (padrão): python
#   Linux/Mac: python3
PYTHON_PATH=python

# ── Isolamento de Voz (Vocal Isolation) ───────────────────────────────────────
# Separação de fontes de áudio (voz vs música de fundo) via Demucs — mitigação
# do copyright strike de 2026-08-24 (Soares Music Digital): lives de oração
# têm música ambiente tocando de fundo, que o Content ID reconhece mesmo sob
# a voz. Aplicado automaticamente aos vídeos do nicho 'religioso' (cortes do
# Bispo em src/processor/ffmpeg.js + vídeo longo em src/canal-da-fe/long-video.js).
#
# Setup (venv Python DEDICADO — dependências pesadas, não reaproveita o do ASD):
#   python -m venv voice_isolation/venv
#   voice_isolation/venv/Scripts/pip install demucs
# Sem DEMUCS_PATH configurado, o pipeline segue com o áudio ORIGINAL sem
# isolar (nunca quebra por causa disso) — só fica sem a mitigação.
DEMUCS_PATH=
# Modelo do Demucs (htdemucs = padrão, boa qualidade; htdemucs_ft é mais lento
# e um pouco melhor se quiser trocar)
DEMUCS_MODEL=htdemucs
# Timeout por vídeo — processo pesado, CPU sem GPU pode levar minutos num
# vídeo longo (sermão de 30-60min)
VOCAL_ISOLATION_TIMEOUT_SEC=600
# Quais nichos passam por isolamento (separado por vírgula) — default 'religioso'
# VOCAL_ISOLATION_NICHES=religioso

# ── Varredura ─────────────────────────────────────────────────────────────────
YOUTUBE_SCAN_DEPTH=8
TWITCH_SCAN_DEPTH=5
SCAN_INTERVAL_HOURS=6

# ── YouTube Monitor ────────────────────────────────────────────────────────────
# Intervalo entre checagens de novos vídeos das personas YouTube (segundos)
YT_MONITOR_INTERVAL=600
# Duração mínima para processar o vídeo (300s = 5min — exclui Shorts e vinhetas)
YT_MONITOR_MIN_DURATION=300

# ── Sports Monitor ─────────────────────────────────────────────────────────────
# Polling automático dos canais em src/capturer/sports-channels.js.
# Cobre jogo completo (gol detectado via chat) e conteúdo esportivo geral —
# resenha, entrevista, humor (heatmap "Most Replayed" como fallback automático).
# Intervalo entre checagens de novos vídeos (segundos)
SPORTS_MONITOR_INTERVAL=900
# Duração mínima para minerar o vídeo (600s = 10min — exclui Shorts/vinhetas)
SPORTS_MONITOR_MIN_DURATION=600
# Cortes com mais de N segundos são publicados no YouTube como vídeo normal
# (sem #shorts), não como Short. Só afeta o YouTube — o TikTok recebe o corte
# normalmente independente da duração. Ver poster/express-poster.js.
EXPRESS_LONG_VIDEO_THRESHOLD_SEC=30

# ── Vídeo longo diário ────────────────────────────────────────────────────────
# O poster publica 1 vídeo longo por dia da pasta output/longos (o mais antigo
# primeiro), via express-poster (metadados sem #shorts). Desative com
# LONG_VIDEO_ENABLED=false. Postar manualmente: npm run poster:longo
LONG_VIDEO_ENABLED=true
# Horário do post diário (cron, fuso TIMEZONE) — padrão 20h
CRON_VIDEO_LONGO=0 20 * * *
# Pasta de onde os vídeos longos são lidos
LONG_VIDEOS_DIR=./output/longos
# Captação de emergência (pasta vazia no horário do post): compilação com os
# maiores picos de heatmap de um vídeo das personas de YouTube
# Replicação de vídeo longo: com a pasta vazia, a 1ª fonte é baixar INTEIRO o
# vídeo em alta dos canais de cortes concorrentes (TREND_CORTES_CHANNELS);
# a compilação de heatmap abaixo vira fallback. Faixa de duração aceita (s):
LONG_REPLICATE_MIN_DURATION=180
LONG_REPLICATE_MAX_DURATION=1200
LONG_CAPTURE_PEAKS=3
LONG_CAPTURE_BEFORE_SEC=90
LONG_CAPTURE_AFTER_SEC=60

# ── Vídeo longo diário — Canal da Fé ───────────────────────────────────────────
# Mesma mecânica do vídeo longo principal, mas a fonte é sempre uma prédica/live
# INTEIRA do próprio canal do Bispo Bruno Leonardo (nunca concorrentes), postada
# no perfil dedicado do canal religioso (chrome-youtube-02 / chrome-tiktok-02).
# Desative com LONG_VIDEO_FE_ENABLED=false. Postar manualmente: npm run poster:longo:fe
LONG_VIDEO_FE_ENABLED=true
# Horário do post diário (cron, fuso TIMEZONE) — padrão 20h30 (30min após o principal)
CRON_VIDEO_LONGO_FE=30 20 * * *
# Pasta de onde os vídeos longos do Canal da Fé são lidos
LONG_VIDEOS_FE_DIR=./output/longos-fe
# Faixa de duração aceita do vídeo-fonte (s) — 300 = 5min, 3600 = 60min
LONG_VIDEO_FE_MIN_DURATION=300
LONG_VIDEO_FE_MAX_DURATION=3600

# ── Vídeo longo diário — Canal Infantil ────────────────────────────────────────
# Mesma mecânica, mas a fonte é sempre um vídeo INTEIRO do próprio canal do
# Luccas Neto (nunca concorrentes), postado no perfil dedicado (chrome-youtube-03).
# Desative com LONG_VIDEO_INFANTIL_ENABLED=false.
LONG_VIDEO_INFANTIL_ENABLED=true
# Horário do post diário — padrão 21h (1h após o principal)
CRON_VIDEO_LONGO_INFANTIL=0 21 * * *
LONG_VIDEOS_INFANTIL_DIR=./output/longos-infantil
LONG_VIDEO_INFANTIL_MIN_DURATION=300
LONG_VIDEO_INFANTIL_MAX_DURATION=3600

# ── Vídeo longo diário — GTA VI ────────────────────────────────────────────────
# Mesma mecânica, mas a fonte é sempre a íntegra de um vídeo em alta dos MESMOS
# canais curados do GTA6 Hunter (TREND_GTA6_CHANNELS, nunca concorrentes
# genéricos), postado no perfil dedicado (chrome-youtube-04). Registry separado
# do dos Shorts — um vídeo já cortado continua elegível pro longo, e vice-versa.
# Desative com LONG_VIDEO_GTA6_ENABLED=false.
LONG_VIDEO_GTA6_ENABLED=true
# Horário do post diário — padrão 21h30
CRON_VIDEO_LONGO_GTA6=30 21 * * *
LONG_VIDEOS_GTA6_DIR=./output/longos-gta6
# Vídeos de análise costumam ser mais longos que os de outros nichos (o do Davy
# Jones passou de 90min) — teto maior que os outros vídeos longos.
LONG_VIDEO_GTA6_MIN_DURATION=300
LONG_VIDEO_GTA6_MAX_DURATION=5400

# ── Contas extras (replicar cortes em mais contas) ────────────────────────────
# Configuração das contas em poster/accounts.js (vazio por padrão = desativado).
# Atraso aleatório (segundos) entre cada conta extra — nunca posta em 2 contas
# ao mesmo tempo pela mesma máquina.
EXTRA_ACCOUNT_DELAY_MIN_SEC=60
EXTRA_ACCOUNT_DELAY_MAX_SEC=180

# Reaproveitadas pelo Sports Monitor e pelo mine:sports manual — ver sports-vod-miner.js
RADAR_KEYWORDS=gol,golaço,goool,goooool,gooool,vaaaaai,pqp,que golaço,que gol
RADAR_SPIKE_WINDOW_MS=15000
RADAR_COOLDOWN_MS=120000
# Janela do clipe LARGO — usado na compilação "vídeo longo" (2+ lances do VOD)
RADAR_CLIP_BEFORE_SEC=150
RADAR_CLIP_AFTER_SEC=30
# Janela do clipe CURTO — derivado localmente do largo (sem 2ª chamada ao yt-dlp),
# fica bem abaixo do limite de 3min do YouTube, garantindo Short de verdade
RADAR_SHORT_BEFORE_SEC=15
RADAR_SHORT_AFTER_SEC=10
RADAR_OUTPUT_DIR=./output/sports-vod

# ── Trend Hunter ───────────────────────────────────────────────────────────────
# Intervalo (horas) entre cada rodada do Trend Hunter (padrão: 12h)
TREND_HUNT_HOURS=12
# Canais YouTube a monitorar (separados por vírgula).
# Se não definido, usa a lista padrão (Flow, Podpah, InteligênciaLtda, etc.)
TREND_YOUTUBE_CHANNELS=https://www.youtube.com/@FlowPodcast,https://www.youtube.com/@Podpah,https://www.youtube.com/@InteligenciaLtda,https://www.youtube.com/@VenusPodcast,https://www.youtube.com/@renatocariani,https://www.youtube.com/@juliobalestrinoficial

# ── Lote por persona no rodízio principal ────────────────────────────────────
# Quantos vídeos seguidos cada persona publica antes de passar a vez. O peso do
# rodízio (campo weight em personas.js) continua valendo entre os lotes.
POSTS_PER_PERSONA=3

# ── Rodízio ponderado por receita (Revenue-Aware Rotation) ────────────────────
# Ajusta o peso EFETIVO de cada persona no rodízio principal (só a conta
# principal — os canais dedicados, religioso/infantil, não entram nesta v1)
# com base na receita média por vídeo dos últimos REVENUE_LOOKBACK_DAYS dias
# (YouTube Analytics API) — quem realmente monetiza ganha mais turnos, não só
# quem viraliza (ver src/scheduler/revenue-weight.js). Complementa o Hotness
# acima (audiência), não substitui.
#
# Pré-requisito: os refresh tokens YOUTUBE_REFRESH_TOKEN_MAIN/_FE precisam ter
# sido gerados COM os escopos de Analytics — refaça se necessário:
#   node poster/youtube-oauth-setup.js --channel main
#   node poster/youtube-oauth-setup.js --channel fe
# Sem o escopo (token antigo) ou sem monetização ativa (YPP) no canal, a
# receita vem zerada/inacessível e o peso fica neutro (1x) — não quebra nada,
# só ainda sem sinal. Inspecione os números ANTES de ativar: npm run revenue
REVENUE_AWARE_ROTATION=false
# Janela de dados considerada no cálculo de receita média por vídeo
REVENUE_LOOKBACK_DAYS=60
# TTL do cache local (scheduler/revenue-cache.json) — evita bater na API a
# cada ciclo de post; a receita do YouTube Analytics já tem defasagem de
# 2-3 dias, então não faz sentido recalcular com mais frequência que isso.
REVENUE_CACHE_HOURS=24
# Mínimo de vídeos atribuídos a uma persona pra confiar no número (evita 1
# vídeo sortudo/azarado disparar um multiplicador extremo)
REVENUE_MIN_SAMPLE=3
# Teto/piso do multiplicador de peso (relativo à mediana das personas
# comparáveis) — nunca deixa uma persona dominar nem ser zerada
REVENUE_MAX_MULTIPLIER=2
REVENUE_MIN_MULTIPLIER=0.5

# ── Rodízio ponderado por inscritos (Subscriber-Aware Rotation) — TESTE ───────
# Mesma mecânica do Revenue-Aware Rotation acima, mas pesando `subscribersGained`
# (métrica NÃO-monetária) em vez de receita — funciona hoje mesmo, sem esperar
# aprovação no YPP. Ativado em 2026-08-23 como TESTE explícito, pra ver se
# enviesar o rodízio por conversão de inscrito bate os pesos declarados
# (inscritos é o gargalo confirmado pro YPP nos 2 canais ativos — ver
# npm run eligibility). Requer o mesmo escopo yt-analytics.readonly do painel
# de elegibilidade.
#
# Cada post grava qual modo estava ativo (postados/metadata-history.json) —
# compare o resultado real por período com: npm run compare-rotation
SUBSCRIBER_AWARE_ROTATION=false
SUBSCRIBER_LOOKBACK_DAYS=60
SUBSCRIBER_CACHE_HOURS=24
SUBSCRIBER_MIN_SAMPLE=3
SUBSCRIBER_MAX_MULTIPLIER=2
SUBSCRIBER_MIN_MULTIPLIER=0.5

# ── Agendamento de Posts ──────────────────────────────────────────────────────
# Horários de pico para Shorts no Brasil (GMT-3)
POST_TIMES=08:00,12:00,18:00,21:00
POST_TIMEZONE=America/Sao_Paulo

# ── Monetização — Configurações de Segurança ─────────────────────────────────
# Ativa filtro de profanidade nas legendas e metadados
CONTENT_FILTER=true
# Temperature do LLM (0.3-0.5 = mais seguro, 0.7-0.9 = mais criativo)
LLM_TEMPERATURE=0.4
# Máximo de tokens por chamada de geração de copy
LLM_MAX_TOKENS=256
# Score mínimo de validação para aprovar um post (0-100)
MIN_VALIDATION_SCORE=60

# ── Thumbnail Creator Pro ───────────────────────────────────────────────────
# Ativa a geração de thumbnails profissionais com IA (requer `sharp` instalado)
CREATE_THUMBNAIL=true

# ── Trend Hunter & Optimizer ────────────────────────────────────────────────
# Ativa a otimização de títulos e descrições com IA para CTR e SEO
OPTIMIZE_CONTENT=true

# (O Trend Hunter é ativado via flag --hunt, não precisa de variável de ambiente)

# ── Canal da Fé no Poster (persona virtual "canaldafe") ───────────────────────
# Vídeos religiosos gerados (roteiro IA + imagens FLUX + narração + Remotion),
# intercalados com os cortes do Bispo no canal dedicado (chrome-youtube-02).
# O pipeline fica em ./canal_da_fe (chaves próprias em canal_da_fe/.env).
# Desativar: CANALDAFE_IN_ROTATION=false
CANALDAFE_IN_ROTATION=true
# Turnos por ciclo no round-robin
CANALDAFE_WEIGHT=1
# Estoque mínimo de vídeos gerados (reposto pelo Stock Watcher)
CANALDAFE_MIN_STOCK=1

# ── Audience Panel (views/likes/comentários dos últimos 3 vídeos/canal) ───────
# Serviço do start.js — Data API v3 (sem depender da Analytics API, que pode
# estar desabilitada no projeto). Custo de cota irrisório (~12 unidades/rodada
# pros 4 canais); 3h é o equilíbrio entre atualizado e não redundante (views
# não mudam muito em poucos minutos). Desative com --no-audience.
AUDIENCE_CHECK_HOURS=3

# ── Stock Watcher (reposição automática de conteúdo) ──────────────────────────
# Serviço do start.js que confere o nível de todas as fontes e repõe o que
# estiver baixo: personas (captação), Canal da Fé (geração), Trend Hunter
# (corte em alta) e vídeos longos (replicação). Desative com --no-stock.
# Intervalo entre checagens (minutos)
STOCK_CHECK_MINUTES=30
# Mínimo de clipes por persona
STOCK_MIN_CLIPS=3
# Mínimo na fila do Trend Hunter
STOCK_MIN_TREND=1
# Mínimo na fila do GTA VI Hunter
STOCK_MIN_GTA6=1
# Mínimo de vídeos longos em output/longos
STOCK_MIN_LONG=1
# Mínimo de vídeos longos do Canal da Fé em output/longos-fe
STOCK_MIN_LONG_FE=1
# Mínimo de vídeos longos do Canal Infantil / GTA VI
STOCK_MIN_LONG_INFANTIL=1
STOCK_MIN_LONG_GTA6=1
# Python do pipeline (padrão: canal_da_fe/venv/Scripts/python.exe se existir)
# CANALDAFE_PYTHON=

# ── Canal Infantil no Poster (persona virtual "canalinfantil") ────────────────
# Terceiro canal: Shorts educativos infantis gerados (roteiro Groq + Pexels +
# Edge-TTS + FFmpeg). Pipeline em ./canal_infantil (chaves próprias no .env de lá).
# Posta em TODOS os horários do cron, no perfil dedicado abaixo.
CANALINFANTIL_IN_ROTATION=true
CANALINFANTIL_MIN_STOCK=1
CANALINFANTIL_PROFILE=./profiles/chrome-youtube-03
# Fundo do vídeo: 'gerado' (gradiente animado local, padrão) ou 'pexels'
# (banco de vídeos — traz pessoas e cenas aleatórias; use com cautela em
# conteúdo infantil). Configurado no .env do subprojeto canal_infantil.
#   INFANTIL_BACKGROUND=gerado
# Tamanho do personagem (fração da largura) e distância do rodapé (px)
#   INFANTIL_CHAR_SCALE=0.68
#   INFANTIL_CHAR_BOTTOM=150
# Fração de temas vindos do Google Trends (0 = só o banco curado)
#   INFANTIL_TRENDING_RATIO=0
# Python do pipeline (padrão: canal_infantil/venv/Scripts/python.exe se existir)
# CANALINFANTIL_PYTHON=

# ── Trend Hunter no Poster (persona virtual "trendhunter") ─────────────────────
# Intercala cortes em alta dos canais concorrentes no round-robin do poster.
# Desativar: TREND_IN_ROTATION=false
TREND_IN_ROTATION=true
# Canais de cortes concorrentes a vasculhar (separados por vírgula)
TREND_CORTES_CHANNELS=https://www.youtube.com/@CortesdoFlow/videos,https://www.youtube.com/@CortesdoInteligencia/videos,https://www.youtube.com/@PodpahCortes/videos
# Turnos por ciclo no round-robin (1 = 1 corte em alta a cada ciclo completo)
TREND_WEIGHT=1
# Clipes gerados por vídeo em alta capturado
TREND_CLIPS_PER_RUN=3
# Vídeos recentes analisados por canal / duração máx. do vídeo-fonte (s)
TREND_SCAN_PER_CHANNEL=10
TREND_MAX_SOURCE_DURATION=3600

# ── Canal GTA VI no Poster (persona virtual "gta6hunter") ──────────────────────
# 4º canal dedicado (perfis chrome-youtube-04/chrome-tiktok-04). Fase pré-
# lançamento (GTA VI sai 19/11/2026): ninguém está jogando ao vivo ainda, então
# em vez de uma persona normal, um Trend Hunter próprio (gta6-capture.js) vasculha
# canais BR de análise/reação ao trailer e corta o vídeo em alta. Login manual
# necessário 1x: node poster/login.js --platform youtube --profile ./profiles/chrome-youtube-04
# (idem --platform tiktok). Desativar: GTA6_IN_ROTATION=false
GTA6_IN_ROTATION=true
# Canais BR de análise/reação de GTA 6 a vasculhar (separados por vírgula).
# Vazio = usa os defaults no código (@DavyJonesGTA6 + @CortesdoDavyJones,
# validados ao vivo em 28-29/08/2026) — rode `node src/trend-hunter/gta6-capture.js`
# isolado antes de confiar neles em produção.
TREND_GTA6_CHANNELS=
GTA6_CLIPS_PER_RUN=3
TREND_GTA6_SCAN_PER_CHANNEL=10
TREND_GTA6_MAX_SOURCE_DURATION=3600
